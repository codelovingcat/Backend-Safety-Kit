<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>BackendSafetyKit</PackageId>
    <Title>Backend Safety Kit</Title>
    <Description>Production-safety and diagnostics primitives for ASP.NET Core applications.</Description>
    <PackageTags>aspnetcore;backend;security;diagnostics;logging;metrics;tracing;problem-details;correlation-id</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/codelovingcat/Backend-Safety-Kit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/codelovingcat/Backend-Safety-Kit</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>First preview (0.1.0-preview.1) of Backend Safety Kit core safety and diagnostics primitives. Prerelease, not a stable release. Review the repository README and documentation for capabilities and limitations.</PackageReleaseNotes>
    <Version>0.1.0-preview.1</Version>
    <Authors>codelovingcat</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md"
          Pack="true"
          PackagePath="README.md"
          PackageReadmeFile="README.md" />
  </ItemGroup>
</Project>
