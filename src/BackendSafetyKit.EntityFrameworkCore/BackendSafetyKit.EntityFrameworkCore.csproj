<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>BackendSafetyKit.EntityFrameworkCore</PackageId>
    <Title>Backend Safety Kit Entity Framework Core Integration</Title>
    <Description>Optional Entity Framework Core SaveChanges diagnostics for Backend Safety Kit.</Description>
    <PackageTags>backend;security;diagnostics;entity-framework-core;efcore;logging</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/codelovingcat/Backend-Safety-Kit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/codelovingcat/Backend-Safety-Kit</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>First preview (0.1.0-preview.1) of the optional Entity Framework Core SaveChanges diagnostics integration. Prerelease, not a stable release. Review the repository README and documentation for capabilities and limitations.</PackageReleaseNotes>
    <Version>0.1.0-preview.1</Version>
    <Authors>codelovingcat</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <ProjectReference Include="..\BackendSafetyKit\BackendSafetyKit.csproj" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md"
          Pack="true"
          PackagePath="README.md"
          PackageReadmeFile="README.md" />
  </ItemGroup>
</Project>
