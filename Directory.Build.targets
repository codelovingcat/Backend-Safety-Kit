<Project>
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(PackageId)' != ''">
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <Target Name="ValidatePackableProjectXmlDocumentation"
          BeforeTargets="CoreCompile"
          Condition="'$(IsPackable)' == 'true' and '$(PackageId)' != ''">
    <Error Condition="'$(GenerateDocumentationFile)' != 'true'"
           Text="Packable project $(MSBuildProjectName) must generate XML documentation. Enable GenerateDocumentationFile and document every public API member." />
  </Target>
</Project>
